# Frontend only needs the API base if you skip the Vite proxy (e.g. production).
VITE_API_BASE=http://127.0.0.1:8000

# Bronner guide body copy (build-time). Default = classic (pre-clarity).
# Set true to use the clarity rewrite. Flip on Vercel, then redeploy.
# VITE_BRONNER_GUIDE_CLARITY=true

# Pin one workspace for every browser on this build. Production should set this
# so Instant Case PDFs and notes reappear across devices without copying a key.
# Leave unset locally if you want a private per-browser workspace.
# VITE_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
